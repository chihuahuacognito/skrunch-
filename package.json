{
  "name": "workout-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@types/jest": "30.0.0",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.14",
    "expo-haptics": "~58.0.8",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "library": "tsx scripts/library/build-library.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/saved/"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ],
    "moduleNameMapper": {
      "^react-native-reanimated/mock$": "<rootDir>/jest/reanimatedMock.js"
    }
  }
}
